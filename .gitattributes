# 统一换行符：仓库内一律存 LF，避免 Windows / Linux 协作者互相覆盖
* text=auto eol=lf

# Windows 脚本必须 CRLF，否则 cmd 可能解析出错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.jar binary
*.jks binary
*.keystore binary
*.so binary
*.a binary
*.apk binary
*.db binary
*.sqlite binary
*.xlsx binary
